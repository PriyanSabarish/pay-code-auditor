GROQ_API_KEY=

# Cascade tiers (see auditor/llm.py). Override if Groq's lineup changes.
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

# Set LLM_PROVIDER=gemini to run the whole cascade on Google's Gemini API instead of
# Groq (see auditor/llm.py). Get a key from https://aistudio.google.com/apikey.
LLM_PROVIDER=groq
GOOGLE_API_KEY=
# gemini-flash-latest (currently gemini-3.8-flash) had only a 20-REQUESTS-PER-DAY free
# quota on the key this was verified against — easy to exhaust with a handful of test
# calls. gemini-3.1-flash-lite had a 500/day free quota instead, so it's the default for
# both tiers here despite the name. Pro-tier models had a free-tier limit of 0 entirely.
# Quotas vary by key/project and change over time — check https://ai.dev/rate-limit
# rather than trusting these numbers to still be current.
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_STRONG_MODEL=gemini-3.1-flash-lite
